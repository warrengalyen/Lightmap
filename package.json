{
    "name": "lightmap",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "test": "vitest",
        "test:run": "vitest run",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "husky",
        "analyze:cleanup": "rimraf reports",
        "analyze:unused": "knip --reporter json > reports/knip/knip-report.json || exit 0",
        "analyze:dupe": "jscpd --format typescript --format javascript src"
    },
    "devDependencies": {
        "@sveltejs/vite-plugin-svelte": "^6.2.4",
        "@testing-library/svelte": "^5.3.1",
        "@types/node": "^25.2.1",
        "@types/three": "^0.182.0",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.14.0",
        "globals": "^17.3.0",
        "husky": "^9.1.7",
        "jscpd": "^4.0.5",
        "jsdom": "^28.1.0",
        "knip": "^5.42.6",
        "lint-staged": "^16.2.7",
        "prettier": "^3.8.1",
        "prettier-plugin-svelte": "^3.4.1",
        "rimraf": "^6.0.1",
        "svelte-eslint-parser": "^1.4.1",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.54.0",
        "vite": "npm:rolldown-vite@7.3.1",
        "vite-plugin-checker": "^0.12.0",
        "vitest": "^4.0.18"
    },
    "overrides": {
        "vite": "npm:rolldown-vite@7.3.1"
    },
    "dependencies": {
        "svelte": "^5.51.3",
        "three": "^0.182.0"
    },
    "lint-staged": {
        "*.{js,ts,svelte}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,css,html,md}": [
            "prettier --write"
        ]
    }
}
